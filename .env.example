# JWT (обязательно смените в production)
JWT_SECRET=change-me-in-production

# --- Безопасность входа ---
REGISTRATION_ENABLED=false
REGISTRATION_INVITE_CODE=ваш-секретный-код-компании
PASSWORD_RESET_CODE=ваш-код-сброса-пароля

# Главный администратор-учредитель (создаётся при первом запуске, если email свободен)
FOUNDER_ADMIN_EMAIL=ваш-email@mail.ru
FOUNDER_ADMIN_PASSWORD=надёжный-пароль-от-6-символов
FOUNDER_ADMIN_FULL_NAME=Главный администратор

PORT=3000

# Production Timeweb — PostgreSQL
DATABASE_URL=postgresql://gen_user:YOUR_PASSWORD@YOUR_HOST:5432/default_db?sslmode=verify-full

# SSL для Timeweb PostgreSQL (по умолчанию включён)
# DATABASE_SSL=false

# Opti топливные карты (когда API будет доступен)
# OPTI_API_BASE_URL=https://api.opti.ru

# --- Резервное копирование (docs/BACKUP.md) ---
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP_LOCAL=14

# S3 (Timeweb S3, Cloudflare R2, Yandex Object Storage)
# BACKUP_S3_ENDPOINT=https://s3.timeweb.cloud
# BACKUP_S3_REGION=ru-1
# BACKUP_S3_BUCKET=reestrpro-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=reestrpro/

# BACKUP_WEBHOOK_URL=https://your-service.com/backup-hook
# BACKUP_TELEGRAM_BOT_TOKEN=
# BACKUP_TELEGRAM_CHAT_ID=
