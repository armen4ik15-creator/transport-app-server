# Локальная разработка — SQLite (по умолчанию, без переменных ниже)
PORT=3000

# Production Timeweb — PostgreSQL «реестр»
# Скопируйте строку с вкладки «Подключение» (тип: Приватный IP или Домен)
DATABASE_URL=postgresql://gen_user:YOUR_PASSWORD@YOUR_HOST:5432/default_db?sslmode=verify-full

# Или отдельными переменными:
# DB_HOST=
# DB_PORT=5432
# DB_NAME=default_db
# DB_USER=gen_user
# DB_PASSWORD=

# SSL для Timeweb PostgreSQL (по умолчанию включён)
# DATABASE_SSL=false
